<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Result Portal</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <div class="login-container">

        <div class="login-box">

            <h1>Student Result Portal</h1>

            <p>Login to view your academic results</p>

            <form action="/login" method="POST">

                <label for="email">
                    College Email
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="student@college.edu"
                    required
                >

                <label for="password">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter your password"
                    required
                >

                <button type="submit">
                    Login
                </button>

            </form>

        </div>

    </div>

</body>

</html>